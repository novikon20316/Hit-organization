rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Core auth check (no get() call) ────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ─── Single cached user fetch ────────────────────────────────────────────
    // ALL role/faculty checks go through this one function.
    // Firestore does NOT cache get() calls between function invocations,
    // so every helper that called getUser() was a separate read.
    // Solution: call userDoc() once per rule and pass it around, OR
    // inline the single get() directly in each match block.
    // We use the inline pattern so each match block pays exactly 1 get().
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ─── Role helpers that accept a pre-fetched user doc ────────────────────
    // These take `u` (the result of userDoc()) so no extra get() is needed.
    function role(u) {
      return u.role;
    }
    function facultyId(u) {
      return u.get('facultyId', '');
    }
    function isStaffRole(u) {
      return role(u) in ['supervisor', 'secondary_supervisor', 'coordinator', 'administrative_secretary', 'program_head', 'internal_examiner',
                         'faculty_admin', 'grad_school_head', 'system_admin'];
    }
    // Roles with cross-faculty (or "all") access
    function isCrossFaculty(u) {
      return role(u) in ['grad_school_head', 'internal_examiner', 'system_admin'];
    }

    // Roles that manage a single faculty
    function isFacultyManager(u) {
      return role(u) in [
        'coordinator', 'faculty_admin', 'program_head', 'administrative_secretary'
      ];
    }

    // Grad-school-level approvers
    function isGradSchoolApprover(u) {
      return role(u) in ['grad_school_head', 'system_admin'];
    }

    // Faculty match helper
    function sameFaculty(u, resourceFacultyId) {
      return facultyId(u) == resourceFacultyId || facultyId(u) == 'all';
    }


    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isSignedIn();   // any signed-in user can read profiles
      allow write: if isSignedIn() && (
        request.auth.uid == userId || isStaffRole(userDoc())
      );

      // TOTP secret/recovery-hash — server (Admin SDK) only. Admin SDK bypasses
      // rules entirely, so this doesn't break 2FA; it just stops the parent
      // doc's permissive read above from ever exposing these fields, since
      // they now live here instead of on users/{userId} directly.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // A project's optional `major` field (set when its supervisor is
    // restricted to specific majors via assignedMajors — see
    // server/src/controllers/supervisorController.ts's createSupervisorProject)
    // narrows which students may even see it, not just apply to it. Missing/
    // empty major means open to every major, unchanged from before this field
    // existed. Written as its own function (one `let`, one get()) rather than
    // composing role(userDoc()) + a second call, matching this file's existing
    // "exactly 1 get() per match block" cost discipline noted above.
    function studentCanReadProjectByMajor(res) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.role == 'student' && res.data.get('status', '') == 'active' &&
        (res.data.get('major', '') == '' || res.data.get('major', '') == u.get('major', ''));
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.get('enrolledStudentIds', []) ||
        studentCanReadProjectByMajor(resource) ||
        isStaffRole(userDoc())
      );
      allow create: if isSignedIn() &&
        role(userDoc()) in ['supervisor', 'faculty_admin', 'system_admin', 'program_head', 'administrative_secretary'];
      allow update: if isSignedIn() &&
        role(userDoc()) in ['supervisor', 'coordinator', 'faculty_admin', 'system_admin', 'program_head', 'administrative_secretary'];
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
    		isStaffRole(userDoc())
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isStaffRole(userDoc())
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /milestones/{milestoneId} {
      allow read: if isSignedIn() && (
        // Data-level checks first (0 get() calls) — fast path for students/supervisors
        request.auth.uid in resource.data.get('studentIds', []) ||
        resource.data.get('supervisorId', '') == request.auth.uid ||
        resource.data.get('secondarySupervisorId', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('examinerIds', []) ||
        // Role check (1 get() call) — for coordinators/admins
        role(userDoc()) in ['system_admin', 'coordinator', 'faculty_admin', 'program_head', 'administrative_secretary', 'grad_school_head',
          'internal_examiner']
      );
      allow create: if isSignedIn() && isStaffRole(userDoc());
      allow update: if isSignedIn() && (
        // Data-level checks first (0 get() calls)
        request.auth.uid in resource.data.get('studentIds', []) ||
        // Role check (1 get() call)
        role(userDoc()) in ['supervisor', 'secondary_supervisor', 'coordinator', 'internal_examiner',
                            'faculty_admin', 'system_admin', 'program_head', 'administrative_secretary', 'grad_school_head']
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        resource.data.graderId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        role(userDoc()) in ['coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin']
      );
      allow create: if isSignedIn() &&
        role(userDoc()) in ['supervisor', 'internal_examiner', 'system_admin'];
      allow update: if isSignedIn() &&
      	resource.data.graderId == request.auth.uid ||
        role(userDoc()) in ['grad_school_head', 'system_admin'];
    }
		// ─────────────────────────────────────────────────────────────────────────
		match /processFiles/{processId} {
    	allow read: if isSignedIn() && (
      	resource.data.studentId == request.auth.uid ||
        resource.data.get('supervisorId', '') == request.auth.uid ||
        resource.data.get('secondarySupervisorId', '') == request.auth.uid ||
        (isFacultyManager(userDoc()) &&
            sameFaculty(userDoc(), resource.data.get('facultyId', ''))) ||
            isCrossFaculty(userDoc()
          )
      );
			allow create: if isSignedIn() && (
      	role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'system_admin'
        ]
      );
      allow update: if isSignedIn() && (
      	resource.data.studentId == request.auth.uid ||
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin'
        ]
      );
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }
    // ─────────────────────────────────────────────────────────────────────────
    match /processTemplates/{templateId} {
      allow read: if isSignedIn() && (
        isFacultyManager(userDoc()) ||
        isCrossFaculty(userDoc())
      );
			allow create: if isSignedIn() &&
        role(userDoc()) in [
          'faculty_admin', 'program_head', 'administrative_secretary', 'system_admin'
        ];
			allow update: if isSignedIn() &&
        role(userDoc()) in [
          'faculty_admin', 'program_head', 'administrative_secretary',
          'grad_school_head', 'system_admin'
        ];
			allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }
    // ─────────────────────────────────────────────────────────────────────────
    match /examinerTokens/{token} {
    	// Get-by-known-token used to be unconditionally public (the token itself
    	// was the only secret). Now requires the second-factor email code to
    	// have been verified first (see server/src/services/examinerAccess.ts's
    	// requestExaminerOtp/verifyExaminerOtp, called from the public
    	// /api/examiner-access/:token/request-otp and /verify-otp endpoints) —
    	// link possession alone no longer reveals the document's contents.
    	// Staff can still always read directly. List must stay denied, or
    	// anyone could enumerate every issued token with an unfiltered collection scan.
    	allow get: if resource.data.otpVerified == true ||
        (isSignedIn() &&
          role(userDoc()) in [
            'coordinator', 'faculty_admin', 'program_head',
            'administrative_secretary', 'grad_school_head', 'system_admin'
          ]
        );
    	allow list: if false;
    	allow create: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'system_admin'
        ];
      // Was `... || true` — that trailing clause made this unconditionally
      // permit ANY update, by ANYONE, unauthenticated, to ANY field on ANY
      // examiner token doc: fake opinions/scores, resurrecting an
      // expired/declined token back to pending, redirecting thesisUrl to a
      // different file. External examiners have no Firebase Auth account by
      // design (see mobile/src/firebase/examinerTokens.ts), so this can't
      // require isSignedIn() — the token itself (the doc ID) is their
      // capability. The real fix is narrowing WHAT an anonymous holder can
      // write to exactly the fields/values examinerTokens.ts's client
      // functions actually use (status/acceptedAt/declinedAt/declineReason/
      // submittedAt/opinion/accessLog, and only forward status transitions),
      // never touching thesisUrl/studentId/examinerEmail/expiresAt/etc.
      // The anonymous branch additionally requires otpVerified == true —
      // the request-otp/verify-otp endpoints (server, admin SDK) are the
      // only way to flip that field, so an anonymous writer must have
      // already passed the second factor before touching anything here.
      allow update: if
        (isSignedIn() &&
          role(userDoc()) in [
            'coordinator', 'faculty_admin', 'program_head',
            'administrative_secretary', 'grad_school_head', 'system_admin'
          ]
        ) ||
        (
          resource.data.otpVerified == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'acceptedAt', 'declinedAt', 'declineReason', 'submittedAt', 'opinion', 'accessLog']
          ) &&
          request.resource.data.status in ['accepted', 'declined', 'submitted', resource.data.status]
        );
			allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }
    // ─────────────────────────────────────────────────────────────────────────
		match /examiners/{examinerId} {
    	allow read: if isSignedIn() && isStaffRole(userDoc());
      allow create: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin'
        ];
      allow update: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin'
        ];
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';

    }
		// ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        role(userDoc()) == 'system_admin'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    match /system/{docId} {
      allow read:  if docId == 'maintenance' || isSignedIn();
      allow write: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    match /auditLog/{entryId} {
      allow read: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'grad_school_head', 'system_admin'
        ];
      // Audit entries are written by Cloud Functions only.
      // Direct client writes are blocked.
      allow write: if false;
    }

    // Failed-login security incidents — server-mediated only. Every step
    // (checking status, confirming/denying) goes through the Express API
    // (services/loginSecurity.ts) via the Admin SDK, which bypasses rules
    // entirely, so denying all client access here doesn't break the feature;
    // it just stops any signed-in (or, since login can be failing, even
    // unauthenticated) client from reading or tampering with an incident
    // directly.
    match /loginSecurityIncidents/{code} {
      allow read, write: if false;
    }

    // Permanent feedback chat (see server/src/controllers/feedbackController.ts).
    // Server-mediated only — every operation (submit, AI classification,
    // erase-if-noise, admin review, resolve) goes through the Express API via
    // the Admin SDK, which bypasses rules entirely, so denying all client
    // access here doesn't break the feature; it just stops a signed-in client
    // from reading/writing another user's feedback (or a not-yet-classified
    // message) directly.
    match /feedbackMessages/{feedbackId} {
      allow read, write: if false;
    }


    // ─── Chats ───────────────────────────────────────────────────────────────
    match /chats/{chatId} {

      function myUid() {
        return request.auth.uid;
      }
      // In the chat scope we need two user docs (self + other participant).
      // We accept this as unavoidable — it's 2 get() calls max, well within limit.
      function myData() {
        return get(/databases/$(database)/documents/users/$(myUid())).data;
      }
      function otherUid() {
        return request.resource.data.participants[
          request.resource.data.participants[0] == myUid() ? 1 : 0
        ];
      }
      function otherData() {
        return get(/databases/$(database)/documents/users/$(otherUid())).data;
      }
      function isParticipant() {
        return request.auth != null && myUid() in resource.data.participants;
      }
      function isCreatingParticipant() {
        return request.auth != null && myUid() in request.resource.data.participants;
      }

      // Chat creation policy — evaluated once, 2 get() calls maximum
      function chatCreateAllowed() {
        let me    = myData();
        let other = otherData();
        return (
          me.role == 'system_admin'
          || me.role in ['coordinator', 'faculty_admin', 'program_head',
                         'administrative_secretary', 'grad_school_head']
          || (me.role == 'faculty_admin' && other.facultyId == me.facultyId)
          || (me.role in ['supervisor', 'secondary_supervisor']
              && other.role == 'student'
              && (
                   other.get('supervisorId', '') == myUid()
                   || (other.get('activeProjectId', '') != ''
                       && get(/databases/$(database)/documents/projects/$(other.activeProjectId)).data.supervisorId == myUid())
                 ))
          || (me.role == 'student'
              && other.role in ['supervisor', 'secondary_supervisor',
                                'coordinator', 'faculty_admin']
              && (
                   me.get('supervisorId', '') == otherUid()
                   || (me.get('activeProjectId', '') != ''
                       && get(/databases/$(database)/documents/projects/$(me.activeProjectId)).data.supervisorId == otherUid())
                   || exists(/databases/$(database)/documents/applications/$(
                        me.get('activeProjectId', 'NONE')))
                 ))
        );
      }


      allow get:    if isParticipant();
      // Was `if request.auth != null` — any signed-in user could list the whole
      // chats collection. Scope list to the same check as get.
      allow list:   if isParticipant();
      allow create: if isCreatingParticipant()
                    && request.resource.data.participants.size() == 2
                    && chatCreateAllowed();
      allow update: if isParticipant();
      allow delete: if false;

      // ── Messages subcollection ────────────────────────────────────────────
      match /messages/{messageId} {
        function parentParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        function isParentParticipant() {
          return request.auth != null && request.auth.uid in parentParticipants();
        }

        allow read: if isParentParticipant();
        allow create: if isParentParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
