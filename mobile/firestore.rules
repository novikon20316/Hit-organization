rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Core auth check (no get() call) ────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ─── Single cached user fetch ────────────────────────────────────────────
    // ALL role/faculty checks go through this one function.
    // Firestore does NOT cache get() calls between function invocations,
    // so every helper that called getUser() was a separate read.
    // Solution: call userDoc() once per rule and pass it around, OR
    // inline the single get() directly in each match block.
    // We use the inline pattern so each match block pays exactly 1 get().
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ─── Role helpers that accept a pre-fetched user doc ────────────────────
    // These take `u` (the result of userDoc()) so no extra get() is needed.
    function role(u) {
      return u.role;
    }
    function facultyId(u) {
      return u.get('facultyId', '');
    }
    function isStaffRole(u) {
      return role(u) in ['supervisor', 'secondary_supervisor', 'coordinator', 'administrative_secretary', 'program_head', 'internal_examiner',
                         'faculty_admin', 'grad_school_head', 'system_admin'];
    }
    // Roles with cross-faculty (or "all") access. grad_school_head/
    // internal_examiner used to be unconditionally cross-faculty by role
    // alone; they now get a real home facultyId like any other staff role
    // (plus an optional per-role "additional faculties" grant server-side —
    // see gradSchoolHeadFacultyIds/internalExaminerFacultyIds on the user
    // doc), so here they only count as cross-faculty if a system_admin has
    // explicitly kept/set their facultyId to the literal 'all' sentinel.
    // Deliberately does NOT attempt to encode the extras arrays here — a
    // real-faculty account with granted extras is still correctly matched
    // via sameFaculty()'s own-faculty check for its home faculty; the extras
    // themselves are enforced by the Express API, not at this rules layer.
    function isCrossFaculty(u) {
      return role(u) == 'system_admin'
        || role(u) == 'administrative_secretary'
        || ((role(u) == 'grad_school_head' || role(u) == 'internal_examiner') && facultyId(u) == 'all');
    }

    // Roles that manage a single faculty
    function isFacultyManager(u) {
      return role(u) in [
        'coordinator', 'faculty_admin', 'program_head', 'administrative_secretary'
      ];
    }

    // Grad-school-level approvers
    function isGradSchoolApprover(u) {
      return role(u) in ['grad_school_head', 'system_admin'];
    }

    // Faculty match helper
    function sameFaculty(u, resourceFacultyId) {
      return facultyId(u) == resourceFacultyId || facultyId(u) == 'all';
    }


    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isSignedIn();   // any signed-in user can read profiles

      // CRITICAL FIX: this used to be a single unrestricted `allow write`
      // covering create+update+delete, granted to (a) the doc's own owner
      // or (b) any staff role — with NO field restriction on either branch.
      // Branch (a) meant any signed-in user, including a plain student,
      // could self-escalate to system_admin with one client-side call:
      //   updateDoc(doc(db,'users',uid), { role: 'system_admin', facultyId: 'all' })
      // Branch (b) was just as bad from the other direction: ANY staff role
      // (even a low-trust one like internal_examiner) could rewrite ANY
      // field — role, facultyId, permissionRules, coordinatorScopes,
      // isActive — on ANY other user's account, since it never checked
      // userId != request.auth.uid or restricted which fields could change.
      // There is no Firebase custom-claims setup and no Cloud Function in
      // this project to re-derive/backstop role server-side against this —
      // server/src/middleware/auth.ts's verifyToken trusts this exact doc.
      //
      // Real account creation/role changes/permission grants all already go
      // through the Express API using the Admin SDK (which bypasses these
      // rules entirely) — see userController.ts's syncData,
      // adminController.ts's updateUserRoleAdmin/updateUserPermissions,
      // facultyAdminController.ts. A repo-wide search found no live client
      // code creating a users doc directly, and exactly one live direct
      // field write to another user's doc: faculty_admin/dashboard.tsx's
      // isActive toggle. Everything else must go through the server.
      allow create: if false;
      allow delete: if false;

      // Self-service — restricted to profile fields that carry no privilege.
      // Add to this allowlist only if a field is confirmed to never affect
      // role/scope/eligibility.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'displayNameHe', 'displayNameEn', 'language'
        ]);

      // CRITICAL FIX: this used to allow ANY staff role (isStaffRole) to
      // flip isActive on ANY other user, cross-faculty, including admins —
      // a plain supervisor or internal_examiner could disable a
      // system_admin's account directly from the client SDK, bypassing the
      // server (and its faculty-scoping) entirely. A repo-wide search
      // confirmed neither client actually needs this broad path: mobile's
      // faculty_admin/dashboard.tsx and web's UserRow.tsx both already call
      // the scoped server endpoints (POST /api/admin/users/:id/toggle-active
      // — facultyAdminController.ts, faculty-scoped — and .../toggle-status
      // — adminController.ts, system_admin-only) instead of writing this
      // field directly. Only system_admin's own admin-panel toggle (which
      // also goes through toggle-status) needs a direct-write fallback here,
      // so this branch is narrowed to system_admin only rather than removed
      // entirely.
      allow update: if isSignedIn() && userId != request.auth.uid && role(userDoc()) == 'system_admin' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isActive'
        ]);

      // TOTP secret/recovery-hash — server (Admin SDK) only. Admin SDK bypasses
      // rules entirely, so this doesn't break 2FA; it just stops the parent
      // doc's permissive read above from ever exposing these fields, since
      // they now live here instead of on users/{userId} directly.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // A project's optional `major` field (set when its supervisor is
    // restricted to specific majors via assignedMajors — see
    // server/src/controllers/supervisorController.ts's createSupervisorProject)
    // narrows which students may even see it, not just apply to it. Missing/
    // empty major means open to every major, unchanged from before this field
    // existed. Written as its own function (one `let`, one get()) rather than
    // composing role(userDoc()) + a second call, matching this file's existing
    // "exactly 1 get() per match block" cost discipline noted above.
    // A project's degree eligibility lives in the `degreeTypes` array (a
    // project can legitimately target both bachelors and masters at once —
    // see NewProjectModal.tsx's checkboxes); pre-migration docs only ever
    // had the single scalar `degreeType` field, so that's the fallback,
    // matching every client-side reader's own `degreeTypes ?? [degreeType]`
    // convention exactly.
    function projectDegreeTypes(res) {
      return res.data.get('degreeTypes', []).size() > 0
        ? res.data.get('degreeTypes', [])
        : [res.data.get('degreeType', '')];
    }

    function studentCanReadProjectByMajor(res) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.role == 'student' && res.data.get('status', '') == 'active' &&
        (res.data.get('major', '') == '' || res.data.get('major', '') == u.get('major', '')) &&
        // A masters student must never be able to read a bachelors-only
        // project (and vice versa) — this was previously unchecked here, so
        // any Firestore query shape other than the app's own (which happens
        // to always add a degreeTypes array-contains clause) could read
        // cross-degree projects; rules, not the client's own query, are the
        // real read-authorization boundary.
        u.get('degreeType', '') in projectDegreeTypes(res);
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.get('enrolledStudentIds', []) ||
        studentCanReadProjectByMajor(resource) ||
        isStaffRole(userDoc())
      );
      allow create: if isSignedIn() &&
        role(userDoc()) in ['supervisor', 'faculty_admin', 'system_admin', 'program_head', 'administrative_secretary'];
      // HIGH FIX: 'supervisor' previously had blanket update access to every
      // project in the system, not just their own — any supervisor could
      // directly rewrite ANOTHER supervisor's enrolledStudentIds/status/
      // major/supervisorId, bypassing the ownership checks the scoped
      // /api/admin/projects/* and /api/supervisor/projects/* endpoints
      // already enforce. The other roles here are real admin-tier accounts
      // (coordinator/faculty_admin/program_head/administrative_secretary/
      // system_admin) whose broader project-management authority is
      // intentional elsewhere in this codebase, so only 'supervisor' gets
      // an ownership constraint added.
      allow update: if isSignedIn() && (
        (role(userDoc()) == 'supervisor' && resource.data.get('supervisorId', '') == request.auth.uid) ||
        role(userDoc()) in ['coordinator', 'faculty_admin', 'system_admin', 'program_head', 'administrative_secretary']
      );
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
    		isStaffRole(userDoc())
      );
      // MEDIUM FIX: create had no studentId check at all (any signed-in user
      // could create an application impersonating another student, or
      // pre-set status to a value like 'approved') and update had no
      // relation-to-the-application check for staff (any staff role could
      // update ANY application, not just ones for their own projects). A
      // repo-wide search found zero live client code writing to this
      // collection directly — real creation/decisions both go through
      // POST /api/applications/apply and /api/supervisor/applications/decision
      // (Admin SDK, bypasses these rules) — so this is safely locked down
      // entirely rather than patched with a narrower policy nothing uses.
      allow create, update: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /milestones/{milestoneId} {
      allow read: if isSignedIn() && (
        // Data-level checks first (0 get() calls) — fast path for students/supervisors
        request.auth.uid in resource.data.get('studentIds', []) ||
        resource.data.get('supervisorId', '') == request.auth.uid ||
        resource.data.get('secondarySupervisorId', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('examinerIds', []) ||
        // Role check (1 get() call) — for coordinators/admins
        role(userDoc()) in ['system_admin', 'coordinator', 'faculty_admin', 'program_head', 'administrative_secretary', 'grad_school_head',
          'internal_examiner']
      );
      // MEDIUM FIX: both had no ownership/relation check — any staff role
      // (even secondary_supervisor or internal_examiner) could create or
      // edit a milestone for a project they have no relation to, across
      // faculties. A repo-wide search found zero live client code writing
      // to this collection directly — real milestone creation/grading/
      // status changes all go through the Express API (submitMilestone,
      // submitMilestoneGrade, updateMilestoneByCoordinator, etc. — Admin
      // SDK, bypasses these rules), so this is safely locked down entirely
      // rather than patched with a narrower policy nothing uses.
      allow create, update: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        resource.data.graderId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        role(userDoc()) in ['coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin']
      );
      // MEDIUM FIX: create never checked request.resource.data.graderId ==
      // request.auth.uid nor that the creator was actually assigned as
      // grader — any supervisor/internal_examiner could create a forged
      // grade doc for any studentId, immediately visible to that student
      // under the read rule above. update also had an operator-precedence
      // bug (missing parens around the graderId branch meant `&&` bound
      // tighter than `||`, so it parsed as
      // `(isSignedIn() && graderId==uid) || role in [...]` — the second
      // branch had no isSignedIn() of its own, though calling userDoc()
      // unauthenticated errors out anyway, so this wasn't independently
      // exploitable). A repo-wide search found zero live client code
      // writing to this collection directly — real grade submission goes
      // through submitMilestoneGrade/submitIndividualGrade (Admin SDK,
      // bypasses these rules), so this is safely locked down entirely
      // rather than patched with a narrower policy nothing uses.
      allow create, update: if false;
    }
		// ─────────────────────────────────────────────────────────────────────────
		match /processFiles/{processId} {
    	allow read: if isSignedIn() && (
      	resource.data.studentId == request.auth.uid ||
        resource.data.get('supervisorId', '') == request.auth.uid ||
        resource.data.get('secondarySupervisorId', '') == request.auth.uid ||
        (isFacultyManager(userDoc()) &&
            sameFaculty(userDoc(), resource.data.get('facultyId', ''))) ||
            isCrossFaculty(userDoc()
          )
      );
			allow create: if isSignedIn() && (
      	role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'system_admin'
        ]
      );
      allow update: if isSignedIn() && (
      	resource.data.studentId == request.auth.uid ||
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin'
        ]
      );
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }
    // ─────────────────────────────────────────────────────────────────────────
    match /processTemplates/{templateId} {
      allow read: if isSignedIn() && (
        isFacultyManager(userDoc()) ||
        isCrossFaculty(userDoc())
      );
			allow create: if isSignedIn() &&
        role(userDoc()) in [
          'faculty_admin', 'program_head', 'administrative_secretary', 'system_admin'
        ];
			allow update: if isSignedIn() &&
        role(userDoc()) in [
          'faculty_admin', 'program_head', 'administrative_secretary',
          'grad_school_head', 'system_admin'
        ];
			allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }
    // ─────────────────────────────────────────────────────────────────────────
    match /examinerTokens/{token} {
    	// Get-by-known-token used to be unconditionally public (the token itself
    	// was the only secret). Now requires the second-factor email code to
    	// have been verified first (see server/src/services/examinerAccess.ts's
    	// requestExaminerOtp/verifyExaminerOtp, called from the public
    	// /api/examiner-access/:token/request-otp and /verify-otp endpoints) —
    	// link possession alone no longer reveals the document's contents.
    	// Staff can still always read directly. List must stay denied, or
    	// anyone could enumerate every issued token with an unfiltered collection scan.
    	allow get: if resource.data.otpVerified == true ||
        (isSignedIn() &&
          role(userDoc()) in [
            'coordinator', 'faculty_admin', 'program_head',
            'administrative_secretary', 'grad_school_head', 'system_admin'
          ]
        );
    	allow list: if false;
    	allow create: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'system_admin'
        ];
      // Was `... || true` — that trailing clause made this unconditionally
      // permit ANY update, by ANYONE, unauthenticated, to ANY field on ANY
      // examiner token doc: fake opinions/scores, resurrecting an
      // expired/declined token back to pending, redirecting thesisUrl to a
      // different file. External examiners have no Firebase Auth account by
      // design (see mobile/src/firebase/examinerTokens.ts), so this can't
      // require isSignedIn() — the token itself (the doc ID) is their
      // capability. The real fix is narrowing WHAT an anonymous holder can
      // write to exactly the fields/values examinerTokens.ts's client
      // functions actually use (status/acceptedAt/declinedAt/declineReason/
      // submittedAt/opinion/accessLog, and only forward status transitions),
      // never touching thesisUrl/studentId/examinerEmail/expiresAt/etc.
      // CRITICAL FIX: otpVerified is a one-way flag — set once by
      // request-otp/verify-otp and never reset on decline/timeout/
      // supersede/staff-revoke — so on its own it doesn't stop an examiner
      // who verified once from writing forever, including after being
      // replaced (services/examinerEscalation.ts's promoteNextExaminer,
      // status → 'superseded') or explicitly revoked by staff (status →
      // 'expired'). This branch previously only restricted which TARGET
      // statuses were legal, never which CURRENT status a write was allowed
      // FROM — a superseded/declined/submitted/expired token stayed
      // writable indefinitely. Now also requires the token's current status
      // to still be 'pending' or 'accepted' (i.e. not yet in a terminal
      // state), so a replaced or revoked examiner is locked out immediately
      // regardless of whether their otpVerified flag was ever cleared.
      allow update: if
        (isSignedIn() &&
          role(userDoc()) in [
            'coordinator', 'faculty_admin', 'program_head',
            'administrative_secretary', 'grad_school_head', 'system_admin'
          ]
        ) ||
        (
          resource.data.otpVerified == true &&
          resource.data.status in ['pending', 'accepted'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'acceptedAt', 'declinedAt', 'declineReason', 'submittedAt', 'opinion', 'accessLog']
          ) &&
          request.resource.data.status in ['accepted', 'declined', 'submitted', resource.data.status]
        );
			allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }
    // ─────────────────────────────────────────────────────────────────────────
		match /examiners/{examinerId} {
    	allow read: if isSignedIn() && isStaffRole(userDoc());
      allow create: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin'
        ];
      allow update: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'administrative_secretary', 'grad_school_head', 'system_admin'
        ];
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';

    }
		// ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        role(userDoc()) == 'system_admin'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    // ─────────────────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    match /system/{docId} {
      allow read:  if docId == 'maintenance' || isSignedIn();
      allow write: if isSignedIn() && role(userDoc()) == 'system_admin';
    }

    // Presence heartbeats (server/src/controllers/presenceController.ts) —
    // powers the system_admin-only "Live Transportation" live-user-count
    // page. Written exclusively by the Admin SDK (bypasses rules), never by
    // clients — a client-writable "I'm online" doc would let anyone spoof
    // another uid's presence.
    match /presence/{uid} {
      allow read: if isSignedIn() && role(userDoc()) == 'system_admin';
      allow write: if false;
    }

    // Minute-by-minute online-count samples for the "Live Transportation"
    // trend chart (server/src/services/presenceHistory.ts) — written
    // exclusively by the Admin SDK on a schedule, never by clients.
    match /presenceHistory/{sampleId} {
      allow read: if isSignedIn() && role(userDoc()) == 'system_admin';
      allow write: if false;
    }

    match /auditLog/{entryId} {
      allow read: if isSignedIn() &&
        role(userDoc()) in [
          'coordinator', 'faculty_admin', 'program_head',
          'grad_school_head', 'system_admin'
        ];
      // Audit entries are written by Cloud Functions only.
      // Direct client writes are blocked.
      allow write: if false;
    }

    // Failed-login security incidents — server-mediated only. Every step
    // (checking status, confirming/denying) goes through the Express API
    // (services/loginSecurity.ts) via the Admin SDK, which bypasses rules
    // entirely, so denying all client access here doesn't break the feature;
    // it just stops any signed-in (or, since login can be failing, even
    // unauthenticated) client from reading or tampering with an incident
    // directly.
    match /loginSecurityIncidents/{code} {
      allow read, write: if false;
    }

    // Permanent feedback chat (see server/src/controllers/feedbackController.ts).
    // Server-mediated only — every operation (submit, AI classification,
    // erase-if-noise, admin review, resolve) goes through the Express API via
    // the Admin SDK, which bypasses rules entirely, so denying all client
    // access here doesn't break the feature; it just stops a signed-in client
    // from reading/writing another user's feedback (or a not-yet-classified
    // message) directly.
    match /feedbackMessages/{feedbackId} {
      allow read, write: if false;
    }


    // ─── Chats ───────────────────────────────────────────────────────────────
    match /chats/{chatId} {

      function myUid() {
        return request.auth.uid;
      }
      // In the chat scope we need two user docs (self + other participant).
      // We accept this as unavoidable — it's 2 get() calls max, well within limit.
      function myData() {
        return get(/databases/$(database)/documents/users/$(myUid())).data;
      }
      function otherUid() {
        return request.resource.data.participants[
          request.resource.data.participants[0] == myUid() ? 1 : 0
        ];
      }
      function otherData() {
        return get(/databases/$(database)/documents/users/$(otherUid())).data;
      }
      function isParticipant() {
        return request.auth != null && myUid() in resource.data.participants;
      }
      function isCreatingParticipant() {
        return request.auth != null && myUid() in request.resource.data.participants;
      }

      // Chat creation policy — evaluated once, 2 get() calls maximum
      function chatCreateAllowed() {
        let me    = myData();
        let other = otherData();
        return (
          me.role == 'system_admin'
          || me.role in ['coordinator', 'faculty_admin', 'program_head',
                         'administrative_secretary', 'grad_school_head']
          || (me.role == 'faculty_admin' && other.facultyId == me.facultyId)
          || (me.role in ['supervisor', 'secondary_supervisor']
              && other.role == 'student'
              && (
                   other.get('supervisorId', '') == myUid()
                   || (other.get('activeProjectId', '') != ''
                       && get(/databases/$(database)/documents/projects/$(other.activeProjectId)).data.supervisorId == myUid())
                 ))
          || (me.role == 'student'
              && other.role in ['supervisor', 'secondary_supervisor',
                                'coordinator', 'faculty_admin']
              && (
                   me.get('supervisorId', '') == otherUid()
                   || (me.get('activeProjectId', '') != ''
                       && get(/databases/$(database)/documents/projects/$(me.activeProjectId)).data.supervisorId == otherUid())
                   || exists(/databases/$(database)/documents/applications/$(
                        me.get('activeProjectId', 'NONE')))
                 ))
        );
      }


      allow get:    if isParticipant();
      // Was `if request.auth != null` — any signed-in user could list the whole
      // chats collection. Scope list to the same check as get.
      allow list:   if isParticipant();
      allow create: if isCreatingParticipant()
                    && request.resource.data.participants.size() == 2
                    && chatCreateAllowed();
      allow update: if isParticipant();
      allow delete: if false;

      // ── Messages subcollection ────────────────────────────────────────────
      match /messages/{messageId} {
        function parentParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        function isParentParticipant() {
          return request.auth != null && request.auth.uid in parentParticipants();
        }

        allow read: if isParentParticipant();
        // The live path is server-mediated (chatController.ts's
        // sendDirectMessage, Admin SDK — bypasses this rule); kept as
        // defense-in-depth matching that endpoint's own validation, now
        // extended for image messages (see server/src/controllers/
        // chatController.ts's CHAT_IMAGE_URL_RE for why the host is pinned
        // rather than accepting any https URL).
        allow create: if isParentParticipant()
          && request.resource.data.senderId == request.auth.uid
          && (
            (
              request.resource.data.get('type', 'text') == 'text' &&
              request.resource.data.text is string &&
              request.resource.data.text.size() > 0 &&
              request.resource.data.text.size() <= 4000
            ) ||
            (
              request.resource.data.type == 'image' &&
              request.resource.data.imageUrl is string &&
              request.resource.data.imageUrl.matches('^https://res\\.cloudinary\\.com/dp7stlfas/image/upload/.*') &&
              request.resource.data.get('text', '') is string &&
              request.resource.data.get('text', '').size() <= 1000
            )
          );
        allow update, delete: if false;
      }
    }
  }
}
