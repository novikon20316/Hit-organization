{
  "compilerOptions": {
    // ===== Environment =====
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // ===== File Layout =====
    "rootDir": "./src",
    "outDir": "./dist",

    // ===== Type Safety =====
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // ===== Interop (IMPORTANT for Express) =====
    "esModuleInterop": true,

    // ===== Output =====
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // ===== Skip noise =====
    "skipLibCheck": true
  }
}