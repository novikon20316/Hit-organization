# Copy this file to .env.local (git-ignored) and fill in real values for
# local dev. In production (Vercel/etc.), set these as real environment
# variables in the hosting dashboard instead of committing a .env file.

# Your deployed Render backend — same one the mobile app already points at.
NEXT_PUBLIC_API_URL=https://hit-organization-web-f8rb.onrender.com

# Firebase web config. These are NOT secrets (they ship inside every client
# bundle by design — Firebase access control is enforced by Firestore
# security rules + the server's verifyToken middleware, not by hiding these
# values). Falling back to the mobile app's own config if unset, so the app
# still runs without this file — but set these explicitly for anything real.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
