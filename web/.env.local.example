# Copy this file to .env.local (git-ignored) and fill in real values for
# local dev. In production (Vercel/etc.), set these as real environment
# variables in the hosting dashboard instead of committing a .env file.

# The deployed backend — Firebase Hosting (hit-organization.web.app) rewrites
# /api/** to the Cloud Run "api" service; same URL the mobile app points at.
# Leave unset to use that default, or point at a local server (e.g.
# http://localhost:5000) for local backend development.
NEXT_PUBLIC_API_URL=https://hit-organization.web.app

# Firebase web config. These are NOT secrets (they ship inside every client
# bundle by design — Firebase access control is enforced by Firestore
# security rules + the server's verifyToken middleware, not by hiding these
# values). Falling back to the mobile app's own config if unset, so the app
# still runs without this file — but set these explicitly for anything real.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check (see lib/firebase.ts). Uses Fraud Defense (formerly reCAPTCHA
# Enterprise) -- classic reCAPTCHA v3 can no longer be newly registered as of
# 2026. Create the key at Google Cloud Console -> Security -> Fraud Defense
# -> Keys -> Create key (domains: hit-organization.web.app,
# hit-organization.firebaseapp.com, localhost), then register it in Firebase
# Console -> App Check -> this web app -> Fraud Defense provider, pasting the
# same site key there.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
